\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Left:} the index set $\mathcal  {A}$ partitioned by support. The group lasso of Eq.~\ref {eq:objective} acts on whole blocks, so the surviving model is always a valid HDMR truncation and the complexity axis counts \emph  {component functions}, not monomials. \textbf  {Right:} schematic of the frontier traced by sweeping $\lambda $ (axes unlabelled---this is an illustration of the object, not data). The horizontal asymptote is the irreducible bound set by the order-2 and top-$m$ truncation; the measured frontier is Fig.~\ref {fig:frontier}.}}{13}{figure.2}\protected@file@percent }
\newlabel{fig:lattice}{{2}{13}{\textbf {Left:} the index set $\mathcal {A}$ partitioned by support. The group lasso of Eq.~\ref {eq:objective} acts on whole blocks, so the surviving model is always a valid HDMR truncation and the complexity axis counts \emph {component functions}, not monomials. \textbf {Right:} schematic of the frontier traced by sweeping $\lambda $ (axes unlabelled---this is an illustration of the object, not data). The horizontal asymptote is the irreducible bound set by the order-2 and top-$m$ truncation; the measured frontier is Fig.~\ref {fig:frontier}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Left: the certified explanation frontier,} $\Delta (\hat  \eta _\mu )$ against surviving HDMR components as $\lambda $ sweeps, clipped at the vacuous level $\Delta =2$ (dashed; reached at $\eta =1/3$). bank-marketing buys a certificate of $0.34$ for $\approx \!80$ components and musk v2 one of $0.52$ for $\approx \!230$; credit-default plateaus near $1.06$; \emph  {gas-drift never leaves the vacuous region at any budget}, so on that dataset the method yields no usable guarantee. \textbf  {Right: the OP1 decoupling test.} Pooled across datasets, label agreement does track the certified residual ($\rho _s=-0.85$)---but the correlation is largely between datasets, and at matched agreement near $0.95$ the realised $\eta _\mu $ still spans roughly $0.1$ to $0.6$. Agreement is a correlated but insufficient proxy.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:frontier}{{3}{13}{\textbf {Left: the certified explanation frontier,} $\Delta (\hat \eta _\mu )$ against surviving HDMR components as $\lambda $ sweeps, clipped at the vacuous level $\Delta =2$ (dashed; reached at $\eta =1/3$). bank-marketing buys a certificate of $0.34$ for $\approx \!80$ components and musk v2 one of $0.52$ for $\approx \!230$; credit-default plateaus near $1.06$; \emph {gas-drift never leaves the vacuous region at any budget}, so on that dataset the method yields no usable guarantee. \textbf {Right: the OP1 decoupling test.} Pooled across datasets, label agreement does track the certified residual ($\rho _s=-0.85$)---but the correlation is largely between datasets, and at matched agreement near $0.95$ the realised $\eta _\mu $ still spans roughly $0.1$ to $0.6$. Agreement is a correlated but insufficient proxy}{figure.3}{}}
